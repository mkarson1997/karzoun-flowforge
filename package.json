{
  "name": "@karzoun/flowforge",
  "version": "0.1.0",
  "description": "TypeScript-first workflow engine for reliable background automation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "migrations", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "workflow",
    "automation",
    "jobs",
    "dag",
    "orchestration",
    "typescript",
    "postgresql",
    "opentelemetry",
    "distributed-systems"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkarson1997/karzoun-flowforge.git"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
